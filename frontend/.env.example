# Roxstar AI Voice Room - frontend environment template
# Copy to .env.local (or .env) and adjust for your setup.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Backend token server (see backend/.env API_HOST / API_PORT)
VITE_TOKEN_ENDPOINT=http://localhost:8000

# Optional: pre-fill the room name field on the join screen.
VITE_DEFAULT_ROOM=roxstar-room
