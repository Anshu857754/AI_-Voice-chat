# ============================================================================
# Roxstar AI Voice Room — environment template
# Copy to .env and fill in real values.  NEVER commit .env.
# ============================================================================

# ---------------------------------------------------------------------------
# LiveKit (required)
#   LIVEKIT_URL      wss://<your-project>.livekit.cloud  (or ws://localhost:7880)
#   API key/secret   from LiveKit Cloud dashboard, or `livekit-server --dev`
#                    defaults (devkey / secret) for a local server.
# ---------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# LLM — OpenRouter (required for real replies)
#   Any OpenAI-compatible chat-completions model slug works.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Model choice (quality vs latency): google/gemini-2.5-flash (fast, cheap default),
# anthropic/claude-haiku-4.5 (fast + most natural Hinglish), anthropic/claude-sonnet-4.5
# or openai/gpt-4o (strongest, slower/costlier).
OPENROUTER_MODEL=google/gemini-2.5-flash
# Reply sampling: short spoken replies; longer cap only when the user asks for detail.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=150
LLM_MAX_TOKENS_DETAIL=400
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=20
OPENROUTER_MAX_RETRIES=2
# Optional attribution headers OpenRouter uses for ranking.
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=Roxstar AI Voice Room

# ---------------------------------------------------------------------------
# STT — Deepgram (default provider)
#   nova-2 with language=multi handles Hindi + English + Hinglish
#   code-switching in a single stream.  See docs/provider-decisions.md.
#   STT_PROVIDER: deepgram | null
# ---------------------------------------------------------------------------
STT_PROVIDER=deepgram
# Deepgram API key (DEEPGRAM_API_KEY is accepted as an alias)
STT_API_KEY=
STT_MODEL=nova-2
STT_LANGUAGE=multi
STT_INTERIM_RESULTS=true
STT_ENDPOINTING_MS=250

# ---------------------------------------------------------------------------
# TTS — ElevenLabs (default provider)
#   eleven_turbo_v2_5 supports Hindi and streams with low latency.
#   Voice IDs below MUST be replaced with Indian Hindi voices from your
#   ElevenLabs voice library (Voices -> copy voice ID).
#   TTS_PROVIDER: elevenlabs | sarvam | silent
#   sarvam: TTS_API_KEY=<key>, TTS_MODEL=<Bulbul model id from Sarvam docs>, TTS_LANGUAGE=hi-IN,
#           DOST_VOICE_ID / SATHI_VOICE_ID = Sarvam speaker names from Sarvam docs (never defaulted here)
# ---------------------------------------------------------------------------
TTS_PROVIDER=elevenlabs
TTS_API_KEY=
TTS_MODEL=eleven_turbo_v2_5
TTS_LANGUAGE=hi
# AI Dost  -> male Indian Hindi voice
DOST_VOICE_ID=
# AI Sathi -> female Indian Hindi voice
SATHI_VOICE_ID=

# ---------------------------------------------------------------------------
# Room / agent behaviour
# ---------------------------------------------------------------------------
ROOM_NAME=roxstar-room
DOST_IDENTITY=roxstar-ai-dost
DOST_DISPLAY_NAME=Roxstar AI Dost
SATHI_IDENTITY=roxstar-ai-sathi
SATHI_DISPLAY_NAME=Roxstar AI Sathi

# Context-window management (see docs/context-management.md)
CONTEXT_RECENT_TURNS=14
CONTEXT_SUMMARY_TRIGGER=24
CONTEXT_SUMMARY_KEEP=14
CONTEXT_MAX_SUMMARY_CHARS=1200

# Routing / turn-taking
ROUTER_MIN_QUESTION_CHARS=3
ROUTER_FOLLOWUP_WINDOW_S=45
TURN_RESPONSE_TIMEOUT_S=120

# Barge-in
INTERRUPT_MIN_SPEECH_MS=200

# Privacy: persist transcripts to disk?  Off by default. See docs/privacy.
PERSIST_TRANSCRIPTS=false
TRANSCRIPT_DIR=./transcripts

# Observability
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------------------------------------------------------------------
# Token server (frontend talks to this)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
TOKEN_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend (Vite) — only VITE_* vars reach the browser.
# The LiveKit URL itself is NOT set here: the frontend gets it from the
# /token response (see backend/app/main.py), so it is never duplicated.
# ---------------------------------------------------------------------------
VITE_TOKEN_ENDPOINT=http://localhost:8000
VITE_DEFAULT_ROOM=roxstar-room

# ---------------------------------------------------------------------------
# Accounts (login / signup)
# ---------------------------------------------------------------------------
AUTH_REQUIRED=true
# Signing key for sessions; leave empty to derive one from LIVEKIT_API_SECRET.
AUTH_SECRET=
AUTH_DB_PATH=./data/users.db
AUTH_TOKEN_TTL_HOURS=168

# ---- Chat history --------------------------------------------------------
# MongoDB Atlas connection string (mongodb+srv://user:password@cluster.mongodb.net/).
# Leave empty to use a local SQLite file (HISTORY_DB_PATH) instead.
MONGODB_URI=
MONGODB_DB=roxstar
HISTORY_DB_PATH=./data/chat.db
HISTORY_RESTORE_TURNS=20
